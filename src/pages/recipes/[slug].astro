---
import { getCollection, type CollectionEntry } from "astro:content";

import RecipePage from "../../components/RecipePage.astro";
import { getRecipeSlug, getRecipeUrl } from "../../lib/recipes";

export async function getStaticPaths() {
  const [recipes, translations] = await Promise.all([
    getCollection("recipes"),
    getCollection("recipesEn"),
  ]);
  const translatedSlugs = new Set(translations.map(getRecipeSlug));

  for (const recipe of recipes) {
    if (!recipe.data.image) {
      console.warn(
        `[recipes] У рецепта "${recipe.data.title}" (${getRecipeSlug(recipe)}) нет главного изображения.`,
      );
    }
  }

  return recipes.map((recipe) => ({
    params: { slug: getRecipeSlug(recipe) },
    props: {
      recipe,
      alternatePath: translatedSlugs.has(getRecipeSlug(recipe))
        ? getRecipeUrl(recipe, "en")
        : undefined,
    },
  }));
}

interface Props {
  recipe: CollectionEntry<"recipes">;
  alternatePath?: string;
}

const { recipe, alternatePath } = Astro.props;
---

<RecipePage recipe={recipe} locale="ru" alternatePath={alternatePath} />
