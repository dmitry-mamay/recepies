---
import { getCollection, type CollectionEntry } from "astro:content";

import RecipePage from "../../../components/RecipePage.astro";
import {
  getAvailableTranslations,
  getRecipeSlug,
  getRecipeUrl,
} from "../../../lib/recipes";

export async function getStaticPaths() {
  const [recipes, translations] = await Promise.all([
    getCollection("recipes"),
    getCollection("recipesEn"),
  ]);
  return getAvailableTranslations(recipes, translations).map((recipe) => ({
      params: { slug: getRecipeSlug(recipe) },
      props: { recipe, alternatePath: getRecipeUrl(recipe, "ru") },
    }));
}

interface Props {
  recipe: CollectionEntry<"recipesEn">;
  alternatePath: string;
}

const { recipe, alternatePath } = Astro.props;
---

<RecipePage recipe={recipe} locale="en" alternatePath={alternatePath} />
